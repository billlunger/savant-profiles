<?xml version="1.0" encoding="UTF-8"?>
<component xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
    xsi:noNamespaceSchemaLocation="racepoint_component_profile.xsd" 
    manufacturer="Barco" 
    model="WME-50_REST" 
    device_class="HD_monitor" 
    minimum_component_engine_version="0.0" 
    rpm_xml_version="1.24" 
    unique_identifier="none">
    <notes>
        This profile utilizes the REST API via a Python helper script.
        It controls Power On/Off, Input Selection, and Brightness.
        Script required: /Users/rpm/scripts/barco_rest_client.py
        NOTE: Configure Component in Blueprint with Username/Password for SSH (e.g. RPM/RPM) to the Savant Host.
        NOTE: Ensure 'Host_IP' state variable is set to the Barco Wall IP Address.
    </notes>

    <control_interfaces preferred="ip" control_optional="false">
        <ip port="22" protocol="ssh" response_time_length_ms="3000">
            <send_postfix type="hex">0D0A</send_postfix>
            <receive_end_condition test_condition="data" type="hex">0A</receive_end_condition>
        </ip>
    </control_interfaces>

    <media_interfaces>
        <input name_on_component="HDMI">
            <video_media type="hdmi" />
            <resource resource_type="AV_MONITOR_SINK" />
        </input>
        <input name_on_component="DisplayPort">
            <video_media type="display_port" />
            <resource resource_type="AV_MONITOR_SINK" />
        </input>
        <data name_on_component="LAN">
            <combined_media>
                <data_media type="ethernet" />
                <control port="22" />
            </combined_media>
        </data>
    </media_interfaces>

    <state_variable_list>
        <state_variable name="Power_State" state_center_binding="Power_State" state_center_type="string" owning_logical_component="HD_monitor">STANDBY</state_variable>
        <state_variable name="SelectedInput" state_center_binding="SelectedInput" state_center_type="string" owning_logical_component="HD_monitor" />
        <state_variable name="Screen_Luminance" state_center_binding="Screen_Luminance" state_center_type="integer" owning_logical_component="HD_monitor" user_editable="yes" min_value="0" max_value="100">50</state_variable>
        
        <state_variable name="HDMI" user_editable="yes" state_center_binding="HDMI" state_center_type="string" owning_logical_component="HD_monitor">HDMI</state_variable>
        <state_variable name="DisplayPort" user_editable="yes" state_center_binding="DisplayPort" state_center_type="string" owning_logical_component="HD_monitor">DisplayPort</state_variable>
        
        <state_variable name="Profile3" user_editable="yes" state_center_binding="Profile3" state_center_type="string" owning_logical_component="HD_monitor">Profile3</state_variable>
        <state_variable name="Profile4" user_editable="yes" state_center_binding="Profile4" state_center_type="string" owning_logical_component="HD_monitor">Profile4</state_variable>
        <state_variable name="Profile5" user_editable="yes" state_center_binding="Profile5" state_center_type="string" owning_logical_component="HD_monitor">Profile5</state_variable>
        <state_variable name="Profile6" user_editable="yes" state_center_binding="Profile6" state_center_type="string" owning_logical_component="HD_monitor">Profile6</state_variable>
        <state_variable name="Profile7" user_editable="yes" state_center_binding="Profile7" state_center_type="string" owning_logical_component="HD_monitor">Profile7</state_variable>

        <!-- New Auth Variables -->
        <state_variable name="API_Key" user_editable="yes" state_center_binding="API_Key" state_center_type="string" owning_logical_component="HD_monitor">ENTER_KEY_HERE</state_variable>
        <state_variable name="Auth_Cookie" state_center_binding="Auth_Cookie" state_center_type="string" owning_logical_component="HD_monitor"></state_variable>
        <state_variable name="Host_IP" user_editable="yes" state_center_binding="Host_IP" state_center_type="string" owning_logical_component="HD_monitor">127.0.0.1</state_variable>
        <state_variable name="User" user_editable="yes" state_center_binding="User" state_center_type="string" owning_logical_component="HD_monitor">RPM</state_variable>
        <state_variable name="Password" user_editable="yes" state_center_binding="Password" state_center_type="string" owning_logical_component="HD_monitor">RPM</state_variable>
    </state_variable_list>

    <logical_component logical_component_name="HD_monitor">
        <implementation>
            <input name_on_component="HDMI">
                <action_to_select name="SelectInputHDMI" />
            </input>
            <input name_on_component="DisplayPort">
                <action_to_select name="SelectInputDisplayPort" />
            </input>
        </implementation>



        <universal_component_actions>
           <action name="PowerOn">
                <command_interface interface="ip">
                    <command response_required="yes">
                        <command_string type="character">python3 /Users/rpm/scripts/barco_rest_client.py </command_string>
                        <parameter_list>
                            <parameter state_variable="Host_IP" parameter_data_type="character" />
                            <parameter parameter_data_type="character"> power --state on --cookie </parameter>
                            <parameter state_variable="Auth_Cookie" parameter_data_type="character" />
                        </parameter_list>
                        <response_codes>
                            <rspmessage status="success" name="PowerOnSuccess">
                                <root_object name="none" matches_required="at_least_one" format="text">
                                    <values path="Power_State=ON" matches_required="at_least_one">
                                        <update state="Power_State" type="string" />
                                    </values>
                                </root_object>
                            </rspmessage>
                        </response_codes>
                        <delay ms_delay="1000" />
                    </command>
                </command_interface>
            </action>

            <action name="PowerOff">
                <command_interface interface="ip">
                    <command response_required="yes">
                        <command_string type="character">python3 /Users/rpm/scripts/barco_rest_client.py </command_string>
                        <parameter_list>
                             <parameter state_variable="Host_IP" parameter_data_type="character" />
                             <parameter parameter_data_type="character"> power --state idle --cookie </parameter>
                             <parameter state_variable="Auth_Cookie" parameter_data_type="character" />
                        </parameter_list>
                        <response_codes>
                            <rspmessage status="success" name="PowerOffSuccess">
                                <root_object name="none" matches_required="at_least_one" format="text">
                                    <values path="Power_State=IDLE" matches_required="at_least_one">
                                        <update state="Power_State" type="string" />
                                    </values>
                                </root_object>
                            </rspmessage>
                        </response_codes>
                        <delay ms_delay="1000" />
                    </command>
                </command_interface>
            </action>
        </universal_component_actions>

