                        </parameter_list>
                        <response_codes>
                            <rspmessage status="success" name="Profile5Selected">
                                <root_object name="none" format="json" matches_required="at_least_one">
                                    <values path="$.result" matches_required="at_least_one">
                                        <update state="SelectedInput" type="string">Profile5</update>
                                    </values>
                                </root_object>
                            </rspmessage>
                        </response_codes>
                    </command>
                </command_interface>
            </action>

            <action name="SelectProfile6">
                <command_interface interface="ip">
                    <command response_required="yes">
                        <http_header name="Content-Type">application/json</http_header>
                        <command_string type="character" http_request_type="POST">/api/v1/wall/preset</command_string>
                        <parameter_list>
                            <parameter parameter_data_type="character" isHttpBody="true">{"name":"</parameter>
                            <parameter parameter_data_type="character" isHttpBody="true" state_variable="Profile6" />
                            <parameter parameter_data_type="character" isHttpBody="true">"}</parameter>
                        </parameter_list>
                        <response_codes>
                            <rspmessage status="success" name="Profile6Selected">
                                <root_object name="none" format="json" matches_required="at_least_one">
                                    <values path="$.result" matches_required="at_least_one">
                                        <update state="SelectedInput" type="string">Profile6</update>
                                    </values>
                                </root_object>
                            </rspmessage>
                        </response_codes>
                    </command>
                </command_interface>
            </action>

            <action name="SelectProfile7">
                <command_interface interface="ip">
                    <command response_required="yes">
                        <http_header name="Content-Type">application/json</http_header>
                        <command_string type="character" http_request_type="POST">/api/v1/wall/preset</command_string>
                        <parameter_list>
                            <parameter parameter_data_type="character" isHttpBody="true">{"name":"</parameter>
                            <parameter parameter_data_type="character" isHttpBody="true" state_variable="Profile7" />
                            <parameter parameter_data_type="character" isHttpBody="true">"}</parameter>
                        </parameter_list>
                        <response_codes>
                            <rspmessage status="success" name="Profile7Selected">
                                <root_object name="none" format="json" matches_required="at_least_one">
                                    <values path="$.result" matches_required="at_least_one">
                                        <update state="SelectedInput" type="string">Profile7</update>
                                    </values>
                                </root_object>
                            </rspmessage>
                        </response_codes>
                    </command>
                </command_interface>
            </action>

            <!-- BRIGHTNESS: POST /api/v1/wall/brightness {"brightness":0-100} -> 202 accepted -->
            <action name="SetBrightness">
                <action_argument name="Level" note="0-100" />
                <command_interface interface="ip">
                    <command response_required="yes">
                        <http_header name="Content-Type">application/json</http_header>
                        <command_string type="character" http_request_type="POST">/api/v1/wall/brightness</command_string>
                        <parameter_list>
                            <parameter parameter_data_type="character" isHttpBody="true">{"brightness":</parameter>
                            <parameter parameter_data_type="character" isHttpBody="true" action_argument="Level" />
                            <parameter parameter_data_type="character" isHttpBody="true">}</parameter>
                        </parameter_list>
                        <response_codes>
                            <rspmessage status="success" name="BrightnessAccepted">
                                <root_object name="none" format="json" matches_required="at_least_one">
                                    <values path="$.result" matches_required="at_least_one" />
                                </root_object>
                            </rspmessage>
                        </response_codes>
                    </command>
                </command_interface>
            </action>

            <action name="SetBrightnessHigh">
                <command_interface interface="ip">
                    <command response_required="yes">
                        <http_header name="Content-Type">application/json</http_header>
                        <command_string type="character" http_request_type="POST">/api/v1/wall/brightness</command_string>
                        <parameter_list>
