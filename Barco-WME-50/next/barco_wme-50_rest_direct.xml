<?xml version="1.0" encoding="UTF-8"?>
<component xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="racepoint_component_profile.xsd"
    manufacturer="Barco"
    model="WME-50 REST Direct"
    device_class="HD_monitor"
    minimum_component_engine_version="0.0"
    rpm_xml_version="2.00"
    unique_identifier="none">
    <notes>
        Controls a Barco video wall directly through the Video Wall Manager Edge REST API.
        No relay server and no session cookie.

        REQUIREMENTS
        - VwM firmware with the REST API "No key" mode (verified on 4.7.0.3).
          In VwM: Menu > System settings > Security > enable API, select "No key".
        - Set the component's IP address in Blueprint to the VwM Edge. Port 443 (HTTPS,
          self-signed certificate).

        INPUTS AND PRESETS
        Inputs and profiles are Barco presets. Set each preset-name state variable
        (HDMI, DisplayPort, Profile3 to Profile7) to the exact preset name in VwM.

        FEEDBACK
        Power and brightness are polled every 30 seconds.
    </notes>

    <control_interfaces preferred="ip" control_optional="false">
        <ip port="443" protocol="https-insecure" response_time_length_ms="6000" />
    </control_interfaces>

    <media_interfaces>
        <input name_on_component="HDMI">
            <video_media type="hdmi" />
            <resource resource_type="AV_MONITOR_SINK" />
        </input>
        <input name_on_component="DisplayPort">
            <video_media type="display_port" />
            <resource resource_type="AV_MONITOR_SINK" />
        </input>
        <data name_on_component="LAN">
            <combined_media>
                <data_media type="ethernet" />
                <control port="443" />
            </combined_media>
        </data>
    </media_interfaces>

    <state_variable_list>
        <state_variable name="Power_State" state_center_binding="Power_State" state_center_type="string" owning_logical_component="HD_monitor">idle</state_variable>
        <state_variable name="SelectedInput" state_center_binding="SelectedInput" state_center_type="string" owning_logical_component="HD_monitor" />
        <state_variable name="Screen_Luminance" state_center_binding="Screen_Luminance" state_center_type="integer" owning_logical_component="HD_monitor" min_value="0" max_value="100" />
        <state_variable name="Screen_Luminance_High" state_center_binding="Screen_Luminance_High" state_center_type="integer" owning_logical_component="HD_monitor" user_editable="yes" min_value="0" max_value="100">100</state_variable>
        <state_variable name="Screen_Luminance_Med" state_center_binding="Screen_Luminance_Med" state_center_type="integer" owning_logical_component="HD_monitor" user_editable="yes" min_value="0" max_value="100">50</state_variable>
        <state_variable name="Screen_Luminance_Low" state_center_binding="Screen_Luminance_Low" state_center_type="integer" owning_logical_component="HD_monitor" user_editable="yes" min_value="0" max_value="100">25</state_variable>
        <state_variable name="HDMI" user_editable="yes" state_center_binding="HDMI" state_center_type="string" owning_logical_component="HD_monitor">HDMI</state_variable>
        <state_variable name="DisplayPort" user_editable="yes" state_center_binding="DisplayPort" state_center_type="string" owning_logical_component="HD_monitor">DisplayPort</state_variable>
        <state_variable name="Profile3" user_editable="yes" state_center_binding="Profile3" state_center_type="string" owning_logical_component="HD_monitor">Profile3</state_variable>
        <state_variable name="Profile4" user_editable="yes" state_center_binding="Profile4" state_center_type="string" owning_logical_component="HD_monitor">Profile4</state_variable>
        <state_variable name="Profile5" user_editable="yes" state_center_binding="Profile5" state_center_type="string" owning_logical_component="HD_monitor">Profile5</state_variable>
        <state_variable name="Profile6" user_editable="yes" state_center_binding="Profile6" state_center_type="string" owning_logical_component="HD_monitor">Profile6</state_variable>
        <state_variable name="Profile7" user_editable="yes" state_center_binding="Profile7" state_center_type="string" owning_logical_component="HD_monitor">Profile7</state_variable>
        <state_variable name="Last_Error" state_center_binding="Last_Error" state_center_type="string" owning_logical_component="HD_monitor" />
    </state_variable_list>

    <logical_component logical_component_name="HD_monitor">
        <implementation>
            <input name_on_component="HDMI">
                <action_to_select name="SelectInputHDMI" />
            </input>
            <input name_on_component="DisplayPort">
                <action_to_select name="SelectInputDisplayPort" />
            </input>
        </implementation>

        <universal_component_actions>
            <!-- POWER: POST /api/v1/wall/power {"power":"on"|"idle"} -> 202 {"result":"accepted"} -->
            <action name="PowerOn">
                <command_interface interface="ip">
                    <command response_required="yes">
                        <http_header name="Content-Type">application/json</http_header>
                        <command_string type="character" http_request_type="POST">/api/v1/wall/power</command_string>
                        <parameter_list>
                            <parameter parameter_data_type="character" isHttpBody="true">{"power":"on"}</parameter>
                        </parameter_list>
                        <response_codes>
                            <rspmessage status="success" name="PowerOnAccepted">
                                <root_object name="none" format="json" matches_required="at_least_one">
                                    <values path="$.result" matches_required="at_least_one">
                                        <update state="Power_State" type="string">on</update>
                                    </values>
                                </root_object>
                            </rspmessage>
                        </response_codes>
                    </command>
                </command_interface>
            </action>

            <action name="PowerOff">
                <command_interface interface="ip">
                    <command response_required="yes">
                        <http_header name="Content-Type">application/json</http_header>
                        <command_string type="character" http_request_type="POST">/api/v1/wall/power</command_string>
                        <parameter_list>
                            <parameter parameter_data_type="character" isHttpBody="true">{"power":"idle"}</parameter>
                        </parameter_list>
                        <response_codes>
                            <rspmessage status="success" name="PowerOffAccepted">
                                <root_object name="none" format="json" matches_required="at_least_one">
                                    <values path="$.result" matches_required="at_least_one">
                                        <update state="Power_State" type="string">idle</update>
                                    </values>
                                </root_object>
                            </rspmessage>
                        </response_codes>
                    </command>
                </command_interface>
            </action>

            <!-- GET /api/v1/wall/power -> {"kind":"groups#wall#state","power":"on|idle|standby"} -->
            <action name="GetPowerState">
                <command_interface interface="ip">
                    <command response_required="yes">
                        <command_string type="character" http_request_type="GET">/api/v1/wall/power</command_string>
                        <response_codes>
                            <rspmessage status="success" name="PowerState">
                                <root_object name="none" format="json" matches_required="at_least_one">
                                    <values path="$.power" matches_required="at_least_one">
                                        <update state="Power_State" type="string" />
                                    </values>
                                </root_object>
                            </rspmessage>
                        </response_codes>
                    </command>
                </command_interface>
                <execute_on_schedule period_ms="30000" send_on_reconnect="true" />
            </action>

            <!-- PRESETS: POST /api/v1/wall/preset {"name":"..."} -> 202 accepted; unknown name -> 500 -->
            <action name="SelectInputHDMI">
                <command_interface interface="ip">
                    <command response_required="yes">
                        <http_header name="Content-Type">application/json</http_header>
                        <command_string type="character" http_request_type="POST">/api/v1/wall/preset</command_string>
                        <parameter_list>
                            <parameter parameter_data_type="character" isHttpBody="true">{"name":"</parameter>
                            <parameter parameter_data_type="character" isHttpBody="true" state_variable="HDMI" />
                            <parameter parameter_data_type="character" isHttpBody="true">"}</parameter>
                        </parameter_list>
                        <response_codes>
                            <rspmessage status="success" name="HDMISelected">
                                <root_object name="none" format="json" matches_required="at_least_one">
                                    <values path="$.result" matches_required="at_least_one">
                                        <update state="SelectedInput" type="string">HDMI</update>
                                    </values>
                                </root_object>
                            </rspmessage>
                            <rspmessage status="failure" name="HDMIPresetError">
                                <root_object name="none" format="json" matches_required="at_least_one">
                                    <values path="$.error.message" matches_required="at_least_one">
                                        <update state="Last_Error" type="string" />
                                    </values>
                                </root_object>
                            </rspmessage>
                        </response_codes>
                    </command>
                </command_interface>
            </action>

            <action name="SelectInputDisplayPort">
                <command_interface interface="ip">
                    <command response_required="yes">
                        <http_header name="Content-Type">application/json</http_header>
                        <command_string type="character" http_request_type="POST">/api/v1/wall/preset</command_string>
                        <parameter_list>
                            <parameter parameter_data_type="character" isHttpBody="true">{"name":"</parameter>
                            <parameter parameter_data_type="character" isHttpBody="true" state_variable="DisplayPort" />
                            <parameter parameter_data_type="character" isHttpBody="true">"}</parameter>
                        </parameter_list>
                        <response_codes>
                            <rspmessage status="success" name="DisplayPortSelected">
                                <root_object name="none" format="json" matches_required="at_least_one">
                                    <values path="$.result" matches_required="at_least_one">
                                        <update state="SelectedInput" type="string">DisplayPort</update>
                                    </values>
                                </root_object>
                            </rspmessage>
                            <rspmessage status="failure" name="DisplayPortPresetError">
                                <root_object name="none" format="json" matches_required="at_least_one">
                                    <values path="$.error.message" matches_required="at_least_one">
                                        <update state="Last_Error" type="string" />
                                    </values>
                                </root_object>
                            </rspmessage>
                        </response_codes>
                    </command>
                </command_interface>
            </action>

            <action name="SelectProfile3">
