                                <root_object name="none" format="json" matches_required="at_least_one">
                                    <values path="$.result" matches_required="at_least_one" />
                                </root_object>
                            </rspmessage>
                        </response_codes>
                    </command>
                </command_interface>
            </action>

            <!-- GET /api/v1/wall/brightness -> {"brightness":50,"maximum":100,"minimum":0,...} -->
            <action name="GetBrightness">
                <command_interface interface="ip">
                    <command response_required="yes">
                        <command_string type="character" http_request_type="GET">/api/v1/wall/brightness</command_string>
                        <response_codes>
                            <rspmessage status="success" name="BrightnessState">
                                <root_object name="none" format="json" matches_required="at_least_one">
                                    <values path="$.brightness" matches_required="at_least_one">
                                        <update state="Screen_Luminance" type="integer" />
                                    </values>
                                </root_object>
                            </rspmessage>
                        </response_codes>
                    </command>
                </command_interface>
                <execute_on_schedule period_ms="30000" send_on_reconnect="true" />
            </action>
        </universal_component_actions>
    </logical_component>
</component>
