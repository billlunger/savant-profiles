                            <parameter parameter_data_type="character" isHttpBody="true" state_variable="Screen_Luminance_High" />
                            <parameter parameter_data_type="character" isHttpBody="true">}</parameter>
                        </parameter_list>
                        <response_codes>
                            <rspmessage status="success" name="BrightnessHighAccepted">
                                <root_object name="none" format="json" matches_required="at_least_one">
