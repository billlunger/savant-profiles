<?xml version="1.0" encoding="UTF-8"?>
<component xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
    xsi:noNamespaceSchemaLocation="racepoint_component_profile.xsd" 
    manufacturer="Barco" 
    model="WME-50" 
    device_class="HD_monitor" 
    minimum_component_engine_version="0.0" 
    rpm_xml_version="1.18" 
    unique_identifier="none">
    <notes>
        This profile utilizes the TEXT API enabled via Menu - System Settings -Security -Text API. 
        This controls Power On/Off, Input Selection, and Brightness. 
        Inputs use HDMI and DisplayPort. 
    </notes>

    <control_interfaces preferred="ip" control_optional="false">
        <ip port="23500" response_time_length_ms="6000" protocol="tcp">
            <send_postfix type="hex">0D0A</send_postfix>
            <receive_end_condition test_condition="data" type="hex">0D0A</receive_end_condition>
        </ip>
    </control_interfaces>

    <media_interfaces>
        <input name_on_component="HDMI">
            <video_media type="hdmi" />
            <resource resource_type="AV_MONITOR_SINK" />
        </input>
        <input name_on_component="DisplayPort">
            <video_media type="display_port" />
            <resource resource_type="AV_MONITOR_SINK" />
        </input>
        <data name_on_component="LAN">
            <combined_media>
                <data_media type="ethernet" />
                <control port="23500" />
            </combined_media>
        </data>
    </media_interfaces>

    <state_variable_list>
        <state_variable name="Power_State" state_center_binding="Power_State" state_center_type="string" owning_logical_component="HD_monitor">STANDBY</state_variable>
        <state_variable name="SelectedInput" state_center_binding="SelectedInput" state_center_type="string" owning_logical_component="HD_monitor" />
        <state_variable name="Screen_Luminance" state_center_binding="Screen_Luminance" state_center_type="integer" owning_logical_component="HD_monitor" user_editable="yes" min_value="0" max_value="100">50</state_variable>
        <state_variable name="HDMI" user_editable="yes" state_center_binding="HDMI" state_center_type="string" owning_logical_component="HD_monitor">HDMI</state_variable>
        <state_variable name="DisplayPort" user_editable="yes" state_center_binding="DisplayPort" state_center_type="string" owning_logical_component="HD_monitor">DisplayPort</state_variable>
        <state_variable name="Profile3" user_editable="yes" state_center_binding="Profile3" state_center_type="string" owning_logical_component="HD_monitor">Profile3</state_variable>
        <state_variable name="Profile4" user_editable="yes" state_center_binding="Profile4" state_center_type="string" owning_logical_component="HD_monitor">Profile4</state_variable>
        <state_variable name="Profile5" user_editable="yes" state_center_binding="Profile5" state_center_type="string" owning_logical_component="HD_monitor">Profile5</state_variable>
        <state_variable name="Profile6" user_editable="yes" state_center_binding="Profile6" state_center_type="string" owning_logical_component="HD_monitor">Profile6</state_variable>
        <state_variable name="Profile7" user_editable="yes" state_center_binding="Profile7" state_center_type="string" owning_logical_component="HD_monitor">Profile7</state_variable>
    </state_variable_list>

    <logical_component logical_component_name="HD_monitor">
        <implementation>
            <input name_on_component="HDMI">
                <action_to_select name="SelectInputHDMI" />
            </input>
            <input name_on_component="DisplayPort">
                <action_to_select name="SelectInputDisplayPort" />
            </input>
        </implementation>

        <universal_component_actions>
           <action name="PowerOn">
                <command_interface interface="ip">
                    <command response_required="yes">
                        <command_string type="character">MyWall set OpState wall on</command_string>
                        <response_codes>
                            <rspcode status="success">{"jsonrpc":"2.0","id":1,"result":null}</rspcode>
                        </response_codes>
                        <delay ms_delay="1000" />
                    </command>
                </command_interface>
            </action>
            <action name="PowerOff">
                <command_interface interface="ip">
                    <command response_required="yes">
                        <command_string type="character">MyWall set OpState wall idle</command_string>
                        <response_codes>
                            <rspcode status="success">{"jsonrpc":"2.0","id":2,"result":null}</rspcode>
                        </response_codes>
                        <delay ms_delay="1000" />
                    </command>
                </command_interface>
            </action>
        </universal_component_actions>

        <custom_component_actions>

            <action name="SelectProfile3">
                <command_interface interface="ip">
                    <command response_required="yes">
                        <command_string type="character"></command_string>
                            <parameter_list>
                                <parameter parameter_data_type="character" >MyWall set SelPreset wall </parameter>
                                <parameter parameter_data_type="character" state_variable="Profile3" />
                            </parameter_list>
                        <response_codes>
                            <rspmessage status="success" name="Profile3ProfileSet">
                                <root_object name="none" matches_required="at_least_one" format="text">
                                    <values path="//done" matches_required="at_least_one">
                                        <update state="SelectedInput" type="string" />
                                    </values>
                                </root_object>
                            </rspmessage>
                        </response_codes>
                        <delay ms_delay="1000" />
                    </command>
                </command_interface>
            </action>

